# ============================
# Rust / Cargo
# ============================

# Generated by Cargo
/target/
**/target/

# Build artifacts
debug/
release/

# Cargo lockfile for libraries (optional)
# Uncomment if your project is a library crate
# Cargo.lock

# If your project includes binaries, keep Cargo.lock
# (for reproducible builds)
# !Cargo.lock

# Backup files generated by rustfmt or editors
**/*.rs.bk

# ============================
# IDEs and Editors
# ============================

# VSCode
.vscode/
*.code-workspace

# IntelliJ / CLion / RustRover
.idea/

# Emacs
*~
\#*\#
.\#*

# Vim
*.swp
*.swo

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================
# OS and Misc
# ============================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Linux
*~

# Logs
*.log

# ============================
# Custom / Temporary Files
# ============================

# Local test data, temporary outputs, or scripts
tmp/
temp/
*.tmp

